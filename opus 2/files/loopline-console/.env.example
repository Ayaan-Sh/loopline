# ---------------------------------------------------------------
# Loopline Console — configuration
# Copy to .env and fill in what you have. Anything left blank runs
# in sample mode instead of failing, so the console always starts.
# ---------------------------------------------------------------

PORT=4000
APP_NAME=Loopline Console

# Set this to require an x-admin-key header on every /api call.
# Leave blank while testing locally.
ADMIN_KEY=

# --- Meta Ads ---------------------------------------------------
# System user token from Business Settings → Users → System Users.
# Permissions needed: ads_read, ads_management, leads_retrieval,
# pages_show_list, pages_manage_metadata, business_management.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000
META_PAGE_ID=
META_API_VERSION=v21.0
# Any string you like — paste the same one into Meta's webhook setup.
META_WEBHOOK_VERIFY_TOKEN=loopline-verify

# --- Supabase ---------------------------------------------------
# Project settings → API. Use the service_role key, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email ------------------------------------------------------
MAIL_FROM="Riya from Loopline Realty <riya@yourdomain.com>"
REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Calls, SMS, WhatsApp (Twilio) ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=

# --- Bot phrasing (optional) ------------------------------------
# Any OpenAI-compatible endpoint. Leave blank to run on rules alone.
#   Ollama local:  http://localhost:11434/v1
#   OpenRouter:    https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b

# --- Business settings (these show up in messages) ---------------
BUSINESS_NAME=Loopline Realty
AGENT_NAME=Riya
BUSINESS_CITY=Pune
# Cheapest unit you can actually sell, in rupees. Drives budget scoring.
MIN_BUDGET=4500000
# No messages sent in this window. Format HH:MM-HH:MM, 24h.
QUIET_HOURS=21:00-09:00
